# Copy this file to ".env" and adjust values as needed.

# Port the server listens on.
PORT=4000
NODE_ENV=development

# Secret used to sign JWT login tokens. Change this in a real app!
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=1d

# Rate limiter: time window in minutes and max requests per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100

# MongoDB connection string. Leave empty to run without a database
# (the app uses in-memory data until you add this).
MONGO_URI=

# Redis connection URL. Leave empty to run without Redis caching.
REDIS_URL=

# Cloudinary credentials (for image uploads). Leave empty to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
